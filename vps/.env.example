# Telegram Bot Token（从 @BotFather 申请）
BOT_TOKEN="把你的_BOT_TOKEN_粘到这里"

# 允许私聊 bot 的 Telegram 用户 ID（多个用英文逗号分隔；给 @userinfobot 发消息可查）
ALLOWED_USER="123456789"

# 允许 bot 响应的群组 ID（多个用英文逗号分隔，通常以 -100 开头；留空则只响应私聊）
ALLOWED_GROUP=""

# 启动通知 / 周检结果发给谁（可选，默认 ALLOWED_USER 里最小的 ID）
BOT_OWNER=""

# 下载目录（原片发完保留在这里，自己定期清理）
SAVE_DIR="/opt/douyin-bot/downloads"

# 大文件发送（Pyrogram/MTProto，上传上限 50MB→2GB，可选）
# https://my.telegram.org → API development tools 申请，两个都填才启用
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# yt-dlp 兜底用的 cookie 文件（Netscape 格式，可选，没有就留默认）
X_COOKIES="/opt/douyin-bot/x-cookies.txt"
DOUYIN_COOKIES="/opt/douyin-bot/douyin-cookies.txt"
